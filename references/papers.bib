@article{li_progress_2018,
	title = {Progress on approaches to software defect prediction},
	volume = {12},
	copyright = {{\textcopyright} 2018 The Institution of Engineering and Technology},
	issn = {1751-8814},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1049/iet-sen.2017.0148},
	doi = {10.1049/iet-sen.2017.0148},
	abstract = {Software defect prediction is one of the most popular research topics in software engineering. It aims to predict defect-prone software modules before defects are discovered, therefore it can be used to better prioritise software quality assurance effort. In recent years, especially for recent 3 years, many new defect prediction studies have been proposed. The goal of this study is to comprehensively review, analyse and discuss the state-of-the-art of defect prediction. The authors survey almost 70 representative defect prediction papers in recent years (January 2014{\textendash}April 2017), most of which are published in the prominent software engineering journals and top conferences. The selected defect prediction papers are summarised to four aspects: machine learning-based prediction algorithms, manipulating the data, effort-aware prediction and empirical studies. The research community is still facing a number of challenges for building methods and many research opportunities exist. The identified challenges can give some practical guidelines for both software engineering researchers and practitioners in future software defect prediction.},
	language = {en},
	number = {3},
	urldate = {2024-03-04},
	journal = {IET Software},
	author = {Li, Zhiqiang and Jing, Xiao-Yuan and Zhu, Xiaoke},
	year = {2018},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1049/iet-sen.2017.0148},
	keywords = {data manipulation, defect-prone software modules, effort-aware prediction, empirical studies, machine learning-based prediction algorithms, quality assurance, research and development, software defect prediction, software engineering journals, software quality, software quality assurance, software reliability},
	pages = {161--175},
	file = {Full Text PDF:C\:\\Users\\danyr\\Zotero\\storage\\WGCD9Z55\\Li et al. - 2018 - Progress on approaches to software defect predicti.pdf:application/pdf;Snapshot:C\:\\Users\\danyr\\Zotero\\storage\\JKRNCILC\\iet-sen.2017.html:text/html},
